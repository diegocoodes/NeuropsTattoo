generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteDocument {
  id        String               @id
  content   Json
  updatedAt DateTime             @updatedAt
  videos    DemonstrationVideo[]
}

model DemonstrationVideo {
  siteId    String
  position  Int
  title     String
  videoUrl  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  site      SiteDocument @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, position])
  @@index([siteId])
}
